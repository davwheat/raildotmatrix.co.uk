{
  "name": "uk-dot-matrix",
  "private": true,
  "description": "Generate a realistic dot matrix display for any UK railway station",
  "version": "0.1.0",
  "author": {
    "name": "David Wheatley",
    "email": "hi@davwheat.dev",
    "url": "https://davwheat.dev/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fontsource/poppins": "^5.3.0",
    "@mpth/react-no-ssr": "^1.0.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-select": "^5.10.2",
    "throttle-debounce": "^5.0.2",
    "uk-railway-stations": "^1.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/throttle-debounce": "^5.0.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1",
    "ws": "^8.21.3"
  },
  "resolutions": {
    "react": "^19",
    "react-dom": "^19",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "license": "MIT",
  "scripts": {
    "build": "cross-env STATIC_EXPORT=true next build --webpack",
    "build:ci": "cross-env STATIC_EXPORT=true next build --webpack",
    "develop": "next dev --webpack",
    "dev": "next dev --webpack",
    "develop:workers": "wrangler pages dev --port 8787",
    "format": "prettier --write \"**/*.{js,jsx,json,md,ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,ts,tsx,css,scss}\"",
    "start": "yarn develop",
    "serve": "yarn wrangler pages dev out/",
    "clean": "rm -rf .next out",
    "test:live": "node scripts/test-live.mjs",
    "test:visual": "node scripts/test-visual.mjs"
  },
  "packageManager": "yarn@4.18.0"
}
