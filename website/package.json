{
  "name": "uk-dot-matrix",
  "private": true,
  "description": "Generate a realistic dot matrix display for any UK railway station",
  "version": "0.1.0",
  "author": {
    "name": "David Wheatley",
    "email": "hi@davwheat.dev",
    "url": "https://davwheat.dev/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@emotion/react": "^11.14.0",
    "@fontsource/poppins": "^5.3.0",
    "@mpth/react-no-ssr": "^1.0.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-select": "^5.10.2",
    "throttle-debounce": "^5.0.2",
    "uk-railway-stations": "^1.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/throttle-debounce": "^5.0.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.8",
    "sass": "^1.105.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "scripts": {
    "board": "just --justfile ../led-board/justfile web",
    "board:quick": "just --justfile ../led-board/justfile ZOPFLI_ITERATIONS=1 web",
    "build": "pnpm board && cross-env STATIC_EXPORT=true next build --webpack",
    "build:ci": "pnpm board && cross-env STATIC_EXPORT=true next build --webpack",
    "develop": "pnpm board:quick && next dev --webpack",
    "dev": "pnpm board:quick && next dev --webpack",
    "develop:workers": "wrangler pages dev --port 8787",
    "format": "prettier --write \"**/*.{js,jsx,json,md,ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,ts,tsx,css,scss}\"",
    "start": "pnpm develop",
    "serve": "wrangler pages dev out/",
    "clean": "rm -rf .next out",
    "test:settings": "node scripts/test-settings.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:management": "node scripts/test-management.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:renderer": "node scripts/test-renderer.mjs",
    "test:wasm": "node scripts/test-wasm.mjs"
  },
  "packageManager": "pnpm@11.18.0"
}
