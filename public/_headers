# X-Frame-Options is removed so railannouncements.co.uk can embed a board in an iframe.
/*
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  ! X-Frame-Options

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The bundle's file names change with its content; only the manifest that names them can go stale.
/led-board/manifest.json
  Cache-Control: no-cache

/led-board/board.*.wasm.gz
  Cache-Control: public, max-age=31536000, immutable

/led-board/wasm_exec.*.js
  Cache-Control: public, max-age=31536000, immutable
