[connection]
id=departure-board-hotspot
uuid=4c376e41-f15d-4dbf-9747-5932b6c9d078
type=wifi
interface-name=wlan0
autoconnect=false

[wifi]
mode=ap
ssid=DepartureBoard
band=bg
channel=6
powersave=2

[wifi-security]
key-mgmt=wpa-psk
proto=rsn;
psk=DotMatrix
# 1 turns PMF off. PMF is a suspected cause of devices failing to join hotspots on the Pi's Broadcom Wi-Fi.
pmf=1

[ipv4]
method=shared
address1=192.168.4.1/24

[ipv6]
method=disabled
