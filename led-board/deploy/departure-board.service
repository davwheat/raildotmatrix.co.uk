[Unit]
Description=Railway departure board on the LED matrix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Fewer GC cycles during large feed updates, with about 2 MiB extra peak memory on Pi Zero 2.
Environment=GOGC=150
ExecStart=/opt/departure-board/board -config /etc/departure-board.toml
Restart=always
RestartSec=5
# The board blanks the panel and exits within a frame of SIGTERM; one that doesn't is stuck, and is killed
# rather than left holding the GPIO for the default 90 s.
TimeoutStopSec=10
Nice=-10

[Install]
WantedBy=multi-user.target
